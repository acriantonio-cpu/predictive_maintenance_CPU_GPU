{
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["-m", "not hardware"],
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.extraPaths": ["src"],
  "[python]": {"editor.defaultFormatter": "charliermarsh.ruff", "editor.rulers": [100]},
  "files.exclude": {"**/__pycache__": true, ".dev": false}
}
